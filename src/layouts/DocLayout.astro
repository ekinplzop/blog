---
import BaseLayout from './BaseLayout.astro';
import EpistemicBanner from '../components/EpistemicBanner.astro';
import TimeMachine from '../components/TimeMachine.astro';

interface Props {
  entry: any;
  headings: any[];
}

const { entry, headings } = Astro.props;
const { title, description, lifecycle, revisions, superseded_by, publishedDate } = entry.data;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={title} description={description}>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- 左栏：文章目录与知识索引 (2 列) -->
    <aside class="hidden lg:block lg:col-span-2 sticky top-20 h-[calc(100vh-6rem)] overflow-y-auto pr-2">
      <div class="text-xs font-mono text-muted mb-4 uppercase tracking-wider font-semibold">
        本文大纲 / TOC
      </div>
      <nav class="space-y-2 text-xs font-mono text-muted">
        {headings.map((h: any) => (
          <a
            href={`#${h.slug}`}
            class={`block hover:text-content transition-colors truncate ${
              h.depth === 2 ? 'font-medium text-content/90' : 'pl-3 text-muted/80'
            }`}
          >
            {h.text}
          </a>
        ))}
      </nav>

      <div class="mt-8 pt-6 border-t border-border">
        <a href={`${baseUrl}/`} class="text-xs font-mono text-sky-500 hover:underline flex items-center gap-1">
          ← 返回数字花园星图
        </a>
      </div>
    </aside>

    <!-- 中栏：阅读主画布 (严格 68ch 宽度控制，居中 7 列) -->
    <article class="lg:col-span-7 max-w-prose mx-auto w-full">
      <!-- 标题与基本元信息 -->
      <header class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-content mb-3 font-sans">
          {title}
        </h1>
        <div class="text-xs font-mono text-muted flex items-center gap-4">
          <span>发布于: {publishedDate}</span>
          <span>·</span>
          <span>版本: v{entry.data.version || '1.0.0'}</span>
        </div>

        <!-- 认知生命周期横幅 -->
        <EpistemicBanner
          status={lifecycle.status}
          confidence={lifecycle.confidence}
          lastVerified={lifecycle.last_verified}
          supersededBy={superseded_by}
        />

        <!-- 认知演进时光机穿梭控制 -->
        <TimeMachine revisions={revisions} />
      </header>

      <!-- Markdown 正文渲染区 (带 Tailwind Typography 排版) -->
      <div class="prose prose-zinc dark:prose-invert max-w-none">
        <slot />
      </div>
    </article>

    <!-- 右栏：Tufte 侧边轨道与 Git 认知修订日志 (3 列) -->
    <aside class="hidden lg:block lg:col-span-3 sticky top-20 h-[calc(100vh-6rem)] overflow-y-auto pl-4 border-l border-border/60">
      <div class="space-y-6">
        <!-- 认知修订轨迹时间轴 -->
        <div>
          <div class="text-xs font-mono text-muted mb-3 uppercase tracking-wider font-semibold flex items-center justify-between">
            <span>认知演进轨迹</span>
            <span class="text-[10px] bg-surface px-1.5 py-0.5 rounded border border-border">Git 追溯</span>
          </div>

          {revisions && revisions.length > 0 ? (
            <div class="relative pl-4 space-y-4 border-l border-border/80 text-xs">
              {revisions.map((rev: any) => (
                <div class="relative group">
                  <span class="absolute -left-[21px] top-1 w-2.5 h-2.5 rounded-full bg-surface border-2 border-sky-500"></span>
                  <div class="font-mono text-[10px] text-muted">{rev.date} {rev.commit ? `· ${rev.commit}` : ''}</div>
                  <div class="text-content/90 font-sans mt-0.5">{rev.summary}</div>
                </div>
              ))}
            </div>
          ) : (
            <div class="text-xs text-muted font-mono italic">
              暂无历史修订记录 (初版成型)
            </div>
          )}
        </div>

        <!-- 旁注提示说明卡片 -->
        <div class="p-3.5 rounded-lg border border-border/60 bg-surface/50 text-xs font-sans text-muted">
          <div class="font-semibold text-content mb-1 font-mono text-[11px]">💡 Tufte 旁注哲学</div>
          所有关于算法收敛性推导与前置公理假设，均通过旁注和状态机实时联动呈现，无需跳出阅读心流。
        </div>
      </div>
    </aside>
  </div>

  <script>
    import renderMathInElement from 'katex/dist/contrib/auto-render.mjs';

    function renderMath() {
      const article = document.querySelector('article');
      if (article) {
        renderMathInElement(article, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '$', right: '$', display: false }
          ],
          throwOnError: false
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMath);
    } else {
      renderMath();
    }
  </script>
</BaseLayout>
