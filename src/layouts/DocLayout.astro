---
import BaseLayout from './BaseLayout.astro';
import EpistemicBanner from '../components/EpistemicBanner.astro';
import TimeMachine from '../components/TimeMachine.astro';
import SidebarTree from '../components/SidebarTree.astro';
import InteractiveEnhancer from '../components/InteractiveEnhancer.astro';
import ContextualFloatingToolbar from '../components/ContextualFloatingToolbar.astro';

interface Props {
  entry: any;
  headings: any[];
}

const { entry, headings } = Astro.props;
const { title, description, lifecycle, revisions, superseded_by, publishedDate } = entry.data;
---

<BaseLayout title={title} description={description} fullWidth={true}>
  <!-- 移动端悬浮目录呼出按钮 (小屏/手机) -->
  <div class="lg:hidden fixed bottom-6 right-6 z-40 flex items-center gap-2">
    <button
      id="mobile-tree-toggle"
      class="flex items-center gap-2 px-4 py-2.5 rounded-full bg-sky-500 text-white font-mono text-xs font-semibold shadow-xl active:scale-95 transition-all"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
      </svg>
      <span>知识库大纲</span>
    </button>
  </div>

  <!-- 移动端抽屉遮罩与侧边栏容器 -->
  <div
    id="mobile-tree-drawer"
    class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm lg:hidden opacity-0 pointer-events-none transition-opacity duration-200"
  >
    <div
      id="mobile-tree-content"
      class="w-4/5 max-w-sm h-full bg-surface border-r border-border p-5 flex flex-col transform -translate-x-full transition-transform duration-200 shadow-2xl"
    >
      <div class="flex items-center justify-between pb-3 mb-2 border-b border-border text-xs font-mono">
        <span class="font-bold text-content">知识库目录导航</span>
        <button id="mobile-tree-close" class="text-muted hover:text-content p-1 text-sm font-bold">✕</button>
      </div>
      <div class="flex-1 overflow-y-auto">
        <SidebarTree currentSlug={entry.slug} />
      </div>
    </div>
  </div>

  <!-- 桌面/平板 侧边栏收起时的边缘恢复浮钮 (Sticky Edge Buttons) -->
  <button
    id="btn-expand-left"
    onclick="window.toggleLeftSidebar && window.toggleLeftSidebar()"
    class="hidden lg:flex fixed left-3 top-20 z-40 items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface/95 border border-sky-500/40 text-xs font-mono text-sky-400 hover:text-white hover:bg-sky-500 shadow-lg backdrop-blur-md transition-all active:scale-95 cursor-pointer opacity-0 pointer-events-none"
    title="点击展开左侧知识库目录"
  >
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
    </svg>
    <span>展开目录</span>
  </button>

  <button
    id="btn-expand-right"
    onclick="window.toggleRightSidebar && window.toggleRightSidebar()"
    class="hidden lg:flex fixed right-3 top-20 z-40 items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface/95 border border-sky-500/40 text-xs font-mono text-sky-400 hover:text-white hover:bg-sky-500 shadow-lg backdrop-blur-md transition-all active:scale-95 cursor-pointer opacity-0 pointer-events-none"
    title="点击展开右侧文章大纲"
  >
    <span>展开大纲</span>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
    </svg>
  </button>

  <!-- 主三栏可自由拖拽调整宽度容器 (IDE 级 Flex 布局) -->
  <div id="resizable-doc-layout" class="flex flex-col lg:flex-row w-full gap-0 relative items-start">
    <!-- 左栏：全站知识库树状导航 (支持手柄拖拽与折叠) -->
    <aside
      id="left-sidebar-col"
      class="hidden lg:block shrink-0 sticky top-20 h-[calc(100vh-6rem)] overflow-hidden pr-3 select-none transition-all duration-200"
      style="width: 280px; min-width: 180px; max-width: 500px;"
    >
      <SidebarTree currentSlug={entry.slug} />
    </aside>

    <!-- 左侧可拖拽手柄分割条 (目录右侧边界线，带居中一键折叠按键) -->
    <div
      id="resizer-left"
      class="hidden lg:flex items-center justify-center w-3 hover:w-3.5 -mr-1.5 -ml-1.5 cursor-col-resize select-none shrink-0 sticky top-20 h-[calc(100vh-6rem)] z-30 group"
      title="按住左右拖拽调整宽度 / 单击小按钮一键折叠"
    >
      <!-- 分界线 -->
      <div class="w-[1px] h-full bg-border group-hover:bg-sky-500/70 group-active:bg-sky-500 transition-colors"></div>
      
      <!-- 目录右边界上的交互式点击折叠手柄按钮 (Notion / IDE 级体验) -->
      <button
        type="button"
        id="btn-resizer-toggle-left"
        onclick="event.stopPropagation(); window.toggleLeftSidebar && window.toggleLeftSidebar();"
        class="absolute top-1/2 -translate-y-1/2 w-5 h-7 rounded-full bg-surface border border-border shadow-md flex items-center justify-center text-muted hover:text-sky-400 hover:border-sky-500/60 cursor-pointer opacity-40 group-hover:opacity-100 transition-all hover:scale-110 active:scale-95"
        title="点击收起/展开左侧目录"
      >
        <svg id="icon-resizer-left" class="w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
    </div>

    <!-- 中栏：阅读主画布 (弹性自适应撑满，最大宽 4xl 居中保证排版与公式延展) -->
    <article id="main-article-canvas" class="flex-1 min-w-0 px-4 sm:px-8 lg:px-12 py-2 w-full max-w-4xl mx-auto transition-all duration-200">
      <!-- 快捷视图栏 (三栏状态快速切换，满足平板与专注阅读) -->
      <div class="hidden lg:flex items-center justify-between mb-4 pb-2.5 border-b border-border/40 text-xs font-mono not-prose select-none">
        <div class="flex items-center gap-2">
          <button
            id="bar-toggle-left"
            onclick="window.toggleLeftSidebar && window.toggleLeftSidebar()"
            class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface/60 hover:bg-surface border border-border/60 hover:border-sky-500/50 text-muted hover:text-content cursor-pointer transition-all active:scale-95"
            title="收起/展开左侧目录"
          >
            <span class="text-sm">◧</span>
            <span id="bar-left-text">收起目录</span>
          </button>
          <button
            id="bar-toggle-right"
            onclick="window.toggleRightSidebar && window.toggleRightSidebar()"
            class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface/60 hover:bg-surface border border-border/60 hover:border-sky-500/50 text-muted hover:text-content cursor-pointer transition-all active:scale-95"
            title="收起/展开右侧大纲"
          >
            <span class="text-sm">◨</span>
            <span id="bar-right-text">收起大纲</span>
          </button>
        </div>

        <button
          id="bar-toggle-zen"
          onclick="window.toggleZenMode && window.toggleZenMode()"
          class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-surface/60 hover:bg-sky-500/10 border border-border/60 hover:border-sky-500/40 text-muted hover:text-sky-400 cursor-pointer transition-all active:scale-95"
          title="全屏专注模式：双侧同时折叠，正文享受最大视野"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0 0l-5-5m-7 11l-5 5m0 0h4m-4 0v-4m16 4v-4m0 4h-4m4 0l-5-5" />
          </svg>
          <span id="bar-zen-text">全屏专注模式</span>
        </button>
      </div>

      <!-- 标题与基本元信息 -->
      <header class="mb-8">
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-content mb-3 font-sans leading-tight">
          {title}
        </h1>
        <div class="text-xs font-mono text-muted flex flex-wrap items-center gap-2 sm:gap-4">
          <span>发布于: {publishedDate}</span>
          <span>·</span>
          <span>路径: {entry.slug}</span>
        </div>

        <!-- 认知生命周期横幅 -->
        <EpistemicBanner
          status={lifecycle.status}
          confidence={lifecycle.confidence}
          lastVerified={lifecycle.last_verified}
          supersededBy={superseded_by}
        />

        <!-- 认知演进时光机穿梭控制 -->
        <TimeMachine revisions={revisions} />
      </header>

      <!-- Markdown 正文渲染区 (带 Tailwind Typography 排版) -->
      <div class="prose prose-zinc dark:prose-invert max-w-none">
        <slot />
      </div>
    </article>

    <!-- 右侧可拖拽手柄分割条 (带居中一键折叠按键) -->
    <div
      id="resizer-right"
      class="hidden lg:flex items-center justify-center w-3 hover:w-3.5 -mr-1.5 -ml-1.5 cursor-col-resize select-none shrink-0 sticky top-20 h-[calc(100vh-6rem)] z-30 group"
      title="按住左右拖拽调整宽度 / 单击小按钮一键折叠"
    >
      <div class="w-[1px] h-full bg-border group-hover:bg-sky-500/70 group-active:bg-sky-500 transition-colors"></div>
      
      <button
        type="button"
        id="btn-resizer-toggle-right"
        onclick="event.stopPropagation(); window.toggleRightSidebar && window.toggleRightSidebar();"
        class="absolute top-1/2 -translate-y-1/2 w-5 h-7 rounded-full bg-surface border border-border shadow-md flex items-center justify-center text-muted hover:text-sky-400 hover:border-sky-500/60 cursor-pointer opacity-40 group-hover:opacity-100 transition-all hover:scale-110 active:scale-95"
        title="点击收起/展开右侧大纲"
      >
        <svg id="icon-resizer-right" class="w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- 右栏：Tufte 侧边轨道、本篇大纲 TOC 与 Git 演进历史 (支持手柄拖拽与折叠) -->
    <aside
      id="right-sidebar-col"
      class="hidden lg:block shrink-0 sticky top-20 h-[calc(100vh-6rem)] overflow-y-auto pl-4 select-none transition-all duration-200"
      style="width: 280px; min-width: 200px; max-width: 450px;"
    >
      <div class="space-y-6">
        <!-- 1. 本篇大纲 TOC -->
        {headings && headings.length > 0 && (
          <div>
            <div class="text-xs font-mono text-muted mb-3 uppercase tracking-wider font-semibold flex items-center justify-between gap-1.5">
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
                </svg>
                <span>本文大纲 / TOC</span>
              </div>
              <button
                id="btn-collapse-right-sidebar"
                onclick="window.toggleRightSidebar && window.toggleRightSidebar()"
                class="flex items-center justify-center p-1 rounded-md hover:bg-surface text-muted hover:text-sky-400 border border-transparent hover:border-border transition-all cursor-pointer"
                title="收起右侧大纲"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
                </svg>
              </button>
            </div>
            <nav class="space-y-1.5 text-xs font-mono text-muted max-h-56 overflow-y-auto pr-1">
              {headings.map((h: any) => (
                <a
                  href={`#${h.slug}`}
                  class={`block hover:text-sky-400 transition-colors truncate ${
                    h.depth === 2 ? 'font-medium text-content/90' : 'pl-3 text-muted/70 text-[11px]'
                  }`}
                  title={h.text}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        )}

        <!-- 2. 认知修订轨迹时间轴 -->
        <div class="pt-4 border-t border-border/60">
          <div class="text-xs font-mono text-muted mb-3 uppercase tracking-wider font-semibold flex items-center justify-between">
            <span>认知演进轨迹</span>
            <span class="text-[10px] bg-surface px-1.5 py-0.5 rounded border border-border">Git 追溯</span>
          </div>

          {revisions && revisions.length > 0 ? (
            <div class="relative pl-4 space-y-4 border-l border-border/80 text-xs">
              {revisions.map((rev: any) => (
                <div class="relative group">
                  <span class="absolute -left-[21px] top-1 w-2.5 h-2.5 rounded-full bg-surface border-2 border-sky-500"></span>
                  <div class="font-mono text-[10px] text-muted">{rev.date} {rev.commit ? `· ${rev.commit}` : ''}</div>
                  <div class="text-content/90 font-sans mt-0.5">{rev.summary}</div>
                </div>
              ))}
            </div>
          ) : (
            <div class="text-xs text-muted font-mono italic">
              暂无历史修订记录 (初版成型)
            </div>
          )}
        </div>

        <!-- 3. Tufte 旁注哲学卡片 -->
        <div class="p-3.5 rounded-lg border border-border/60 bg-surface/50 text-xs font-sans text-muted">
          <div class="font-semibold text-content mb-1 font-mono text-[11px]">💡 Tufte 旁注哲学</div>
          点击分界线或上方按钮可随时收起任意侧边栏，正文将自动伸展撑满屏幕。
        </div>
      </div>
    </aside>
  </div>

  <!-- 移动端侧边栏交互脚本 -->
  <script is:inline>
    const toggleBtn = document.getElementById('mobile-tree-toggle');
    const drawer = document.getElementById('mobile-tree-drawer');
    const content = document.getElementById('mobile-tree-content');
    const closeBtn = document.getElementById('mobile-tree-close');

    function openDrawer() {
      if (!drawer || !content) return;
      drawer.classList.remove('opacity-0', 'pointer-events-none');
      drawer.classList.add('opacity-100', 'pointer-events-auto');
      content.classList.remove('-translate-x-full');
      content.classList.add('translate-x-0');
    }

    function closeDrawer() {
      if (!drawer || !content) return;
      drawer.classList.remove('opacity-100', 'pointer-events-auto');
      drawer.classList.add('opacity-0', 'pointer-events-none');
      content.classList.remove('translate-x-0');
      content.classList.add('-translate-x-full');
    }

    if (toggleBtn) toggleBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (drawer) {
      drawer.addEventListener('click', (e) => {
        if (e.target === drawer) closeDrawer();
      });
    }
  </script>

  <!-- 桌面/平板 侧边栏折叠/展开/拖拽/专注模式引擎 (带 localStorage 持久化记忆) -->
  <script is:inline>
    (function () {
      const leftCol = document.getElementById('left-sidebar-col');
      const rightCol = document.getElementById('right-sidebar-col');
      const resizerLeft = document.getElementById('resizer-left');
      const resizerRight = document.getElementById('resizer-right');
      const mainArticle = document.getElementById('main-article-canvas');

      const btnExpandLeft = document.getElementById('btn-expand-left');
      const btnExpandRight = document.getElementById('btn-expand-right');

      const barLeftText = document.getElementById('bar-left-text');
      const barRightText = document.getElementById('bar-right-text');
      const barZenText = document.getElementById('bar-zen-text');

      const iconResizerLeft = document.getElementById('icon-resizer-left');
      const iconResizerRight = document.getElementById('icon-resizer-right');

      if (!leftCol || !rightCol || !resizerLeft || !resizerRight) return;

      // 1. 状态管理
      let isLeftCollapsed = localStorage.getItem('garden-sidebar-left-collapsed') === 'true';
      let isRightCollapsed = localStorage.getItem('garden-sidebar-right-collapsed') === 'true' || window.innerWidth <= 1240;

      let savedLeftW = parseInt(localStorage.getItem('garden-sidebar-left-w') || '280', 10);
      let savedRightW = parseInt(localStorage.getItem('garden-sidebar-right-w') || '280', 10);

      function applyLayout() {
        // 左侧栏折叠/展开
        if (isLeftCollapsed) {
          leftCol.style.width = '0px';
          leftCol.style.minWidth = '0px';
          leftCol.style.paddingRight = '0px';
          leftCol.style.opacity = '0';
          leftCol.style.pointerEvents = 'none';

          // 分割线贴齐左边界
          if (iconResizerLeft) {
            iconResizerLeft.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />';
          }

          if (btnExpandLeft) {
            btnExpandLeft.classList.remove('opacity-0', 'pointer-events-none');
            btnExpandLeft.classList.add('opacity-100', 'pointer-events-auto');
          }
          if (barLeftText) barLeftText.textContent = '展开目录';
        } else {
          leftCol.style.width = `${savedLeftW}px`;
          leftCol.style.minWidth = '180px';
          leftCol.style.paddingRight = '';
          leftCol.style.opacity = '1';
          leftCol.style.pointerEvents = 'auto';

          if (iconResizerLeft) {
            iconResizerLeft.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />';
          }

          if (btnExpandLeft) {
            btnExpandLeft.classList.remove('opacity-100', 'pointer-events-auto');
            btnExpandLeft.classList.add('opacity-0', 'pointer-events-none');
          }
          if (barLeftText) barLeftText.textContent = '收起目录';
        }

        // 右侧栏折叠/展开
        if (isRightCollapsed) {
          rightCol.style.width = '0px';
          rightCol.style.minWidth = '0px';
          rightCol.style.paddingLeft = '0px';
          rightCol.style.opacity = '0';
          rightCol.style.pointerEvents = 'none';

          if (iconResizerRight) {
            iconResizerRight.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />';
          }

          if (btnExpandRight) {
            btnExpandRight.classList.remove('opacity-0', 'pointer-events-none');
            btnExpandRight.classList.add('opacity-100', 'pointer-events-auto');
          }
          if (barRightText) barRightText.textContent = '展开大纲';
        } else {
          rightCol.style.width = `${savedRightW}px`;
          rightCol.style.minWidth = '200px';
          rightCol.style.paddingLeft = '';
          rightCol.style.opacity = '1';
          rightCol.style.pointerEvents = 'auto';

          if (iconResizerRight) {
            iconResizerRight.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />';
          }

          if (btnExpandRight) {
            btnExpandRight.classList.remove('opacity-100', 'pointer-events-auto');
            btnExpandRight.classList.add('opacity-0', 'pointer-events-none');
          }
          if (barRightText) barRightText.textContent = '收起大纲';
        }

        // 全屏专注状态
        const isZen = isLeftCollapsed && isRightCollapsed;
        if (barZenText) barZenText.textContent = isZen ? '退出专注模式' : '全屏专注模式';
        if (mainArticle) {
          mainArticle.className = `flex-1 min-w-0 px-4 sm:px-8 lg:px-12 py-2 w-full ${isZen ? 'max-w-5xl' : 'max-w-4xl'} mx-auto transition-all duration-200`;
        }

        localStorage.setItem('garden-sidebar-left-collapsed', String(isLeftCollapsed));
        localStorage.setItem('garden-sidebar-right-collapsed', String(isRightCollapsed));
      }

      // 暴露全局切换函数，确保所有按钮 100% 触发生效
      window.toggleLeftSidebar = function () {
        isLeftCollapsed = !isLeftCollapsed;
        applyLayout();
      };

      window.toggleRightSidebar = function () {
        isRightCollapsed = !isRightCollapsed;
        applyLayout();
      };

      window.toggleZenMode = function () {
        const currentlyZen = isLeftCollapsed && isRightCollapsed;
        if (currentlyZen) {
          isLeftCollapsed = false;
          isRightCollapsed = false;
        } else {
          isLeftCollapsed = true;
          isRightCollapsed = true;
        }
        applyLayout();
      };

      // 2. 鼠标左右拖拽调整宽度
      let isDraggingLeft = false;
      let isDraggingRight = false;

      resizerLeft.addEventListener('mousedown', (e) => {
        if (e.target.closest('button')) return; // 如果点的是按钮，不触发拖拽
        isDraggingLeft = true;
        document.body.style.cursor = 'col-resize';
        document.body.style.userSelect = 'none';
        e.preventDefault();
      });

      resizerLeft.addEventListener('dblclick', () => {
        savedLeftW = 280;
        leftCol.style.width = '280px';
        localStorage.setItem('garden-sidebar-left-w', '280');
      });

      resizerRight.addEventListener('mousedown', (e) => {
        if (e.target.closest('button')) return;
        isDraggingRight = true;
        document.body.style.cursor = 'col-resize';
        document.body.style.userSelect = 'none';
        e.preventDefault();
      });

      resizerRight.addEventListener('dblclick', () => {
        savedRightW = 280;
        rightCol.style.width = '280px';
        localStorage.setItem('garden-sidebar-right-w', '280');
      });

      window.addEventListener('mousemove', (e) => {
        if (isDraggingLeft) {
          const rect = leftCol.getBoundingClientRect();
          let newWidth = e.clientX - rect.left;
          newWidth = Math.max(180, Math.min(480, newWidth));
          savedLeftW = newWidth;
          leftCol.style.width = `${newWidth}px`;
          localStorage.setItem('garden-sidebar-left-w', String(newWidth));
        } else if (isDraggingRight) {
          const rect = rightCol.getBoundingClientRect();
          let newWidth = rect.right - e.clientX;
          newWidth = Math.max(200, Math.min(450, newWidth));
          savedRightW = newWidth;
          rightCol.style.width = `${newWidth}px`;
          localStorage.setItem('garden-sidebar-right-w', String(newWidth));
        }
      });

      window.addEventListener('mouseup', () => {
        if (isDraggingLeft || isDraggingRight) {
          isDraggingLeft = false;
          isDraggingRight = false;
          document.body.style.cursor = '';
          document.body.style.userSelect = '';
        }
      });

      // 初始化应用布局
      applyLayout();
    })();
  </script>

  <!-- 全局 KaTeX 数学公式自动补丁渲染 -->
  <script>
    import renderMathInElement from 'katex/dist/contrib/auto-render.mjs';

    function renderMath() {
      const article = document.querySelector('article');
      if (article) {
        renderMathInElement(article, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '$', right: '$', display: false }
          ],
          throwOnError: false
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMath);
    } else {
      renderMath();
    }
  </script>

  <!-- 全局 Mermaid 流程图/拓扑图自动渲染 -->
  <script>
    async function renderMermaid() {
      const mermaidNodes = document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"], pre.mermaid, code.language-mermaid');
      if (mermaidNodes.length === 0) return;

      const mermaid = (await import('mermaid')).default;
      const isDark = document.documentElement.classList.contains('dark');
      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'neutral',
        fontFamily: 'Inter, -apple-system, sans-serif',
        securityLevel: 'loose',
        flowchart: {
          htmlLabels: true,
          curve: 'basis',
        },
      });

      for (let i = 0; i < mermaidNodes.length; i++) {
        const el = mermaidNodes[i];
        const pre = el.tagName === 'PRE' ? el : el.closest('pre');
        if (!pre || pre.getAttribute('data-processed')) continue;
        pre.setAttribute('data-processed', 'true');

        const code = pre.textContent || '';
        const container = document.createElement('div');
        container.className = 'mermaid-diagram flex justify-center my-6 p-4 rounded-xl border border-border bg-surface/50 overflow-x-auto shadow-sm';
        const id = `mermaid-svg-${i}-${Date.now()}`;

        try {
          const { svg } = await mermaid.render(id, code.trim());
          container.innerHTML = svg;
          pre.parentNode?.replaceChild(container, pre);
        } catch (err) {
          console.error('Mermaid render error:', err);
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMermaid);
    } else {
      renderMermaid();
    }
  </script>

  <!-- 全局 Obsidian Callout 美化与 Reactive Markdown DSL 引擎 -->
  <InteractiveEnhancer />
  <!-- 划选上下文感知工具浮条 -->
  <ContextualFloatingToolbar />
</BaseLayout>
