---
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';
import GlobalKeymap from '../components/GlobalKeymap.astro';

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
}

const { title, description = 'Cognitive Kernel - 个人认知演进与活体数字花园', fullWidth = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} | Cognitive Kernel</title>
    <!-- 防闪烁暗黑模式脚本 -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col selection:bg-sky-500/20 selection:text-sky-400">
    <!-- 顶部流光阅读进度指示微条 (Claude 推荐微交互) -->
    <div id="scroll-indicator" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-sky-500 via-emerald-400 to-sky-400 z-50 transition-all duration-75 ease-out opacity-0 pointer-events-none" style="width: 0%;"></div>

    <!-- 顶部极简导航栏 (增强毛玻璃与底纹微光) -->
    <header class="sticky top-0 z-40 w-full border-b border-border/80 glass-surface shadow-xs">
      <div class={`w-full mx-auto h-14 flex items-center justify-between ${fullWidth ? 'max-w-[1920px] px-4 sm:px-8' : 'max-w-7xl px-4 sm:px-6'}`}>
        <div class="flex items-center gap-6">
          <a href={`${baseUrl}/`} class="flex items-center gap-2 group">
            <span class="w-2 h-2 rounded-full bg-sky-500 group-hover:scale-125 transition-transform"></span>
            <span class="font-mono font-bold tracking-tight text-content text-sm">
              COGNITIVE<span class="text-sky-500">.KERNEL</span>
            </span>
          </a>
          <nav class="hidden md:flex items-center gap-4 text-xs font-mono text-muted">
            <a href={`${baseUrl}/`} class="hover:text-content transition-colors">/ 首页图谱</a>
            <a href={`${baseUrl}/docs/consensus-decay`} class="hover:text-content transition-colors">/ 示例长文</a>
          </nav>
        </div>

        <div class="flex items-center gap-3">
          <!-- GitHub 开源仓库按钮 -->
          <a
            href="https://github.com/ekinplzop/blog"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-border bg-surface/50 text-muted hover:text-content hover:border-sky-500/50 text-xs font-mono transition-colors group"
            title="查看 GitHub 源代码 (MIT 开源)"
          >
            <svg class="w-4 h-4 fill-current group-hover:text-sky-400 transition-colors" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span class="hidden md:inline">GitHub</span>
          </a>

          <!-- ⌘K 搜索按钮 -->
          <button
            onclick="window.openCommandPalette && window.openCommandPalette()"
            class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-lg border border-border bg-surface/50 text-muted hover:text-content text-xs font-mono transition-colors"
            title="快捷键 Ctrl+K 或 Cmd+K"
          >
            <span>⌘K 检索</span>
            <kbd class="text-[10px] bg-surface px-1 py-0.5 rounded border border-border text-muted">Ctrl+K</kbd>
          </button>

          <!-- 快捷键帮助按钮 -->
          <button
            onclick="window.openKeymapHelp && window.openKeymapHelp()"
            class="hidden sm:flex items-center justify-center p-2 rounded-lg border border-border text-muted hover:text-content hover:bg-surface transition-colors cursor-pointer"
            title="查看全局极客快捷键 (? 键)"
          >
            <span class="font-mono text-xs font-bold">?</span>
          </button>

          <!-- 主题切换按钮 -->
          <button
            id="theme-toggle"
            class="p-2 rounded-lg border border-border text-muted hover:text-content hover:bg-surface transition-colors"
            title="切换暗黑/浅色模式"
          >
            <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- 主视图容器 -->
    <main class={`flex-1 w-full mx-auto py-6 sm:py-8 ${fullWidth ? 'max-w-[1920px] px-3 sm:px-6 lg:px-8' : 'max-w-7xl px-4 sm:px-6'}`}>
      <slot />
    </main>

    <!-- 极简页脚 (带 GitHub 开源与 MIT License 说明) -->
    <footer class="border-t border-border mt-auto py-8 text-xs text-muted font-mono">
      <div class={`w-full mx-auto px-4 ${fullWidth ? 'max-w-[1920px]' : 'max-w-7xl'} flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left`}>
        <div>Cognitive Kernel · Local-First 活体认知花园 · 0KB 纯静态离线保障</div>
        <div class="flex items-center gap-3">
          <a href="https://github.com/ekinplzop/blog" target="_blank" rel="noopener noreferrer" class="hover:text-sky-400 hover:underline flex items-center gap-1 text-content">
            <span>GitHub 开源仓库</span>
            <span class="text-[10px]">↗</span>
          </a>
          <span>·</span>
          <a href="https://github.com/ekinplzop/blog/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="hover:text-sky-400 hover:underline">
            MIT License
          </a>
          <span>·</span>
          <a href={`${baseUrl}/docs/how-i-built-cognitive-kernel`} class="text-sky-400 hover:underline">
            设计哲学
          </a>
        </div>
      </div>
    </footer>

    <script is:inline>
      // 滚动进度条监听
      const bar = document.getElementById('scroll-indicator');
      if (bar) {
        window.addEventListener('scroll', () => {
          const total = document.documentElement.scrollHeight - window.innerHeight;
          if (total > 0) {
            const progress = (window.scrollY / total) * 100;
            bar.style.width = `${progress}%`;
            bar.style.opacity = progress > 1 ? '1' : '0';
          }
        }, { passive: true });
      }

      const toggle = document.getElementById('theme-toggle');
      if (toggle) {
        toggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.contains('dark');
          if (isDark) {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('theme', 'light');
          } else {
            document.documentElement.classList.add('dark');
            localStorage.setItem('theme', 'dark');
          }
        });
      }
    </script>
    <!-- ⌘K 命令控制面板 -->
    <CommandPalette />
    <!-- 全局极客快捷键漫游 -->
    <GlobalKeymap />
  </body>
</html>
