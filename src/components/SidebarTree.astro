---
import { getCollection } from 'astro:content';
import { buildDocTree } from '../utils/docTree';
import DocTreeItem from './DocTreeItem.astro';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const allDocs = await getCollection('docs');
const docTree = buildDocTree(allDocs);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="h-full flex flex-col">
  <!-- 侧边栏顶部控制条 -->
  <div class="flex items-center justify-between pb-3 mb-2 border-b border-border/80 text-xs font-mono">
    <div class="flex items-center gap-1.5 text-content font-bold tracking-tight">
      <svg class="w-4 h-4 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      <span>知识库索引</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-[10px] font-mono text-muted bg-surface px-1.5 py-0.5 rounded border border-border">
        {allDocs.length} 篇
      </span>
      <button
        id="btn-collapse-left-sidebar"
        class="hidden lg:flex items-center justify-center p-1 rounded-md hover:bg-surface text-muted hover:text-content border border-transparent hover:border-border transition-all"
        title="收起左侧目录"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- 目录树滚动区 -->
  <div class="flex-1 overflow-y-auto pr-1 space-y-1">
    {docTree.map((node) => (
      <DocTreeItem
        node={node}
        currentSlug={currentSlug}
        baseUrl={baseUrl}
        level={0}
      />
    ))}
  </div>

  <!-- 底部快速返回导航 -->
  <div class="pt-3 mt-auto border-t border-border/80">
    <a
      href={`${baseUrl}/`}
      class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-mono text-sky-500 hover:text-sky-400 hover:bg-sky-500/10 transition-colors"
    >
      <span>← 空间星图总览</span>
      <span class="text-[10px]">ESC / ⌘K</span>
    </a>
  </div>
</div>
