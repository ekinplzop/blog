---
import type { GraphData } from '../utils/graph';

interface Props {
  data: GraphData;
}

const { data } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="relative w-full rounded-2xl border border-border bg-surface/40 overflow-hidden backdrop-blur-sm group">
  <!-- 顶部状态指示与控制栏 -->
  <div class="absolute top-3 left-3 z-10 flex items-center gap-2 pointer-events-none">
    <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface/90 border border-border text-[11px] font-mono text-muted backdrop-blur-md shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-500" id="graph-status-dot"></span>
      <span id="graph-status-text">● 静态图谱已就绪 (静止沉浸 · 0% CPU)</span>
    </div>
    <span class="hidden sm:inline-block text-[11px] font-mono text-muted/70 bg-surface/70 px-2.5 py-1 rounded-full border border-border/50 backdrop-blur-sm">
      悬停探索引力链 · 拖拽自由排布 · 双击直达
    </span>
  </div>

  <div class="absolute top-3 right-3 z-10 flex items-center gap-2">
    <button
      id="graph-reset-btn"
      class="px-2.5 py-1 text-[11px] font-mono rounded-lg bg-surface/80 border border-border hover:border-sky-500/60 text-muted hover:text-content backdrop-blur-md transition-all active:scale-95"
      title="重新初始化物理分布"
    >
      ↺ 重新排列
    </button>
  </div>

  <!-- 悬浮卡片 (聚焦时滑出) -->
  <div
    id="graph-node-popover"
    class="absolute bottom-4 left-4 right-4 sm:right-auto sm:max-w-sm z-20 p-4 rounded-xl bg-surface/95 border border-border shadow-2xl backdrop-blur-xl transition-all duration-300 transform translate-y-8 opacity-0 pointer-events-none"
  >
    <div class="flex items-start justify-between gap-2 mb-2">
      <span id="popover-status-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono font-medium border"></span>
      <button id="popover-close-btn" class="text-muted hover:text-content text-xs p-1">✕</button>
    </div>
    <h4 id="popover-title" class="text-sm font-bold text-content leading-snug mb-1.5 font-sans"></h4>
    <div id="popover-tags" class="flex flex-wrap gap-1 mb-3"></div>
    <a
      id="popover-link"
      href="#"
      class="inline-flex items-center justify-center w-full py-1.5 px-3 rounded-lg bg-sky-500 hover:bg-sky-400 text-white font-mono text-xs font-semibold transition-colors shadow-sm"
    >
      进入文章阅读 →
    </a>
  </div>

  <!-- 主绘图 Canvas -->
  <canvas
    id="cognitive-canvas"
    class="w-full h-[400px] sm:h-[500px] cursor-grab active:cursor-grabbing block"
  ></canvas>
</div>

<script is:inline define:vars={{ graphData: data, baseUrl }}>
  (function () {
    const canvas = document.getElementById('cognitive-canvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const resetBtn = document.getElementById('graph-reset-btn');
    const popover = document.getElementById('graph-node-popover');
    const popoverTitle = document.getElementById('popover-title');
    const popoverBadge = document.getElementById('popover-status-badge');
    const popoverTags = document.getElementById('popover-tags');
    const popoverLink = document.getElementById('popover-link');
    const popoverClose = document.getElementById('popover-close-btn');

    let width = 0;
    let height = 0;
    let dpr = window.devicePixelRatio || 1;

    // 状态色彩系统
    const colors = {
      evergreen: {
        fill: '#10b981',
        glow: 'rgba(16, 185, 129, 0.28)',
        label: 'Evergreen · 常青',
        badge: 'border-emerald-500/40 text-emerald-400 bg-emerald-500/10',
      },
      'in-progress': {
        fill: '#0284c7',
        glow: 'rgba(2, 132, 199, 0.28)',
        label: 'In-Progress · 演进',
        badge: 'border-sky-500/40 text-sky-400 bg-sky-500/10',
      },
      seedling: {
        fill: '#f59e0b',
        glow: 'rgba(245, 158, 11, 0.28)',
        label: 'Seedling · 萌芽',
        badge: 'border-amber-500/40 text-amber-400 bg-amber-500/10',
      },
      superseded: {
        fill: '#f43f5e',
        glow: 'rgba(244, 63, 94, 0.28)',
        label: 'Superseded · 已废弃',
        badge: 'border-rose-500/40 text-rose-400 bg-rose-500/10',
      },
    };

    // 单步物理迭代模拟 (用于初始化预计算与手动拖拽)
    function simulateStep(nodeList) {
      const kCoulomb = 900;
      const kSpring = 0.03;
      const kCenter = 0.006;
      const damping = 0.82;

      // 1. 斥力
      for (let i = 0; i < nodeList.length; i++) {
        for (let j = i + 1; j < nodeList.length; j++) {
          const a = nodeList[i];
          const b = nodeList[j];
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const dist = Math.hypot(dx, dy) || 1;

          if (dist < 200) {
            const force = kCoulomb / (dist * dist);
            const fx = (dx / dist) * force;
            const fy = (dy / dist) * force;

            if (!a.isDragging) { a.vx -= fx; a.vy -= fy; }
            if (!b.isDragging) { b.vx += fx; b.vy += fy; }
          }
        }
      }

      // 2. 弹簧力
      graphData.links.forEach((link) => {
        const a = nodeList.find((n) => n.id === link.source);
        const b = nodeList.find((n) => n.id === link.target);
        if (!a || !b) return;

        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const dist = Math.hypot(dx, dy) || 1;
        const targetDist = link.type === 'supersede' ? 120 : 75;
        const force = (dist - targetDist) * kSpring;
        const fx = (dx / dist) * force;
        const fy = (dy / dist) * force;

        if (!a.isDragging) { a.vx += fx; a.vy += fy; }
        if (!b.isDragging) { b.vx += fx; b.vy += fy; }
      });

      // 3. 向心力与位置更新
      const cx = width / 2;
      const cy = height / 2;

      nodeList.forEach((n) => {
        if (!n.isDragging) {
          n.vx += (cx - n.x) * kCenter;
          n.vy += (cy - n.y) * kCenter;
          n.vx *= damping;
          n.vy *= damping;
          n.x += n.vx;
          n.y += n.vy;

          const pad = n.radius + 15;
          n.x = Math.max(pad, Math.min(width - pad, n.x));
          n.y = Math.max(pad, Math.min(height - pad, n.y));
        }
      });
    }

    // 初始化：按学科分布 + 内存中静默预计算 80 步，开屏直接就是完美静止的星图
    function initNodes() {
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;

      const categories = Array.from(new Set(graphData.nodes.map(n => n.category || '默认')));
      const catCenters = {};
      categories.forEach((cat, idx) => {
        const angle = (idx / categories.length) * Math.PI * 2;
        const dist = Math.min(width, height) * 0.32;
        catCenters[cat] = {
          x: width / 2 + Math.cos(angle) * dist,
          y: height / 2 + Math.sin(angle) * dist,
        };
      });

      const nodeList = graphData.nodes.map((n) => {
        const center = catCenters[n.category || '默认'] || { x: width / 2, y: height / 2 };
        const offsetAngle = Math.random() * Math.PI * 2;
        const offsetDist = Math.random() * 50;

        return {
          ...n,
          x: center.x + Math.cos(offsetAngle) * offsetDist,
          y: center.y + Math.sin(offsetAngle) * offsetDist,
          vx: 0,
          vy: 0,
          isDragging: false,
        };
      });

      // 内存中静默演算 80 步直接收敛，彻底杜绝开屏乱跳
      for (let step = 0; step < 80; step++) {
        simulateStep(nodeList);
      }

      return nodeList;
    }

    let nodes = initNodes();
    let hoveredNode = null;
    let selectedNode = null;
    let draggedNode = null;

    if (resetBtn) {
      resetBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        nodes = initNodes();
        draw();
      });
    }

    // 纯静态单帧渲染：只有在鼠标悬停或拖拽时才绘制一帧，平时完全 0 运算
    function draw() {
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.classList.contains('dark');
      const textColor = isDark ? '#f3f4f6' : '#111827';
      const linkBaseColor = isDark ? 'rgba(255, 255, 255, 0.07)' : 'rgba(0, 0, 0, 0.05)';

      // 1. 绘制连线
      graphData.links.forEach((link) => {
        const a = nodes.find((n) => n.id === link.source);
        const b = nodes.find((n) => n.id === link.target);
        if (!a || !b) return;

        const isRelated =
          hoveredNode && (hoveredNode.id === a.id || hoveredNode.id === b.id);

        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);

        if (link.type === 'supersede') {
          ctx.strokeStyle = isRelated ? '#f43f5e' : 'rgba(244, 63, 94, 0.35)';
          ctx.lineWidth = isRelated ? 2.5 : 1.5;
          ctx.setLineDash([4, 4]);
        } else {
          ctx.strokeStyle = isRelated ? '#38bdf8' : linkBaseColor;
          ctx.lineWidth = isRelated ? 2 : 1;
          ctx.setLineDash([]);
        }

        ctx.globalAlpha = hoveredNode ? (isRelated ? 1 : 0.05) : 1;
        ctx.stroke();
        ctx.setLineDash([]);
      });

      // 2. 绘制节点
      nodes.forEach((n) => {
        const c = colors[n.status] || colors['in-progress'];
        const isHovered = hoveredNode && hoveredNode.id === n.id;
        const isSelected = selectedNode && selectedNode.id === n.id;

        let isConnected = false;
        if (hoveredNode) {
          isConnected =
            hoveredNode.id === n.id ||
            graphData.links.some(
              (l) =>
                (l.source === hoveredNode.id && l.target === n.id) ||
                (l.target === hoveredNode.id && l.source === n.id)
            );
        }

        ctx.globalAlpha = hoveredNode ? (isConnected ? 1 : 0.18) : 0.9;

        // 呼吸微光仅在悬停或特定常青节点开启
        if (isHovered || isSelected || (n.radius >= 15 && !hoveredNode)) {
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.radius + (isHovered ? 7 : 3), 0, Math.PI * 2);
          ctx.fillStyle = c.glow;
          ctx.fill();
        }

        ctx.beginPath();
        ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
        ctx.fillStyle = c.fill;
        ctx.fill();

        ctx.lineWidth = isHovered ? 2.5 : 1.2;
        ctx.strokeStyle = isDark ? '#18181b' : '#ffffff';
        ctx.stroke();

        // 智能标签
        const shouldShowLabel = isHovered || isConnected || (!hoveredNode && n.radius >= 16);

        if (shouldShowLabel) {
          ctx.save();
          ctx.globalAlpha = isHovered ? 1 : 0.85;
          ctx.font = isHovered ? '600 11px Inter, sans-serif' : '500 10px Inter, sans-serif';
          ctx.textAlign = 'center';

          if (isHovered) {
            const titleText = n.title;
            const textWidth = ctx.measureText(titleText).width;
            ctx.fillStyle = isDark ? 'rgba(18, 18, 22, 0.92)' : 'rgba(255, 255, 255, 0.95)';
            ctx.fillRect(n.x - textWidth / 2 - 6, n.y + n.radius + 5, textWidth + 12, 18);
            ctx.strokeStyle = isDark ? 'rgba(255,255,255,0.15)' : 'rgba(0,0,0,0.1)';
            ctx.lineWidth = 1;
            ctx.strokeRect(n.x - textWidth / 2 - 6, n.y + n.radius + 5, textWidth + 12, 18);
          }

          ctx.fillStyle = isHovered ? (isDark ? '#38bdf8' : '#0284c7') : textColor;
          const displayTitle = isHovered ? n.title : (n.title.length > 8 ? n.title.slice(0, 8) + '…' : n.title);
          ctx.fillText(displayTitle, n.x, n.y + n.radius + (isHovered ? 18 : 14));
          ctx.restore();
        }
      });

      ctx.restore();
    }

    function getCanvasCoords(e) {
      const rect = canvas.getBoundingClientRect();
      return {
        x: e.clientX - rect.left,
        y: e.clientY - rect.top,
      };
    }

    // 鼠标滑动：纯样式高亮，绝对不动位置！
    canvas.addEventListener('mousemove', (e) => {
      const { x, y } = getCanvasCoords(e);

      if (draggedNode) {
        draggedNode.x = x;
        draggedNode.y = y;
        draw();
        return;
      }

      const hit = nodes.find((n) => Math.hypot(n.x - x, n.y - y) <= n.radius + 6);
      if (hit !== hoveredNode) {
        hoveredNode = hit;
        canvas.style.cursor = hit ? 'pointer' : 'grab';
        draw(); // 单帧高亮重绘，不触发生理运动
      }
    });

    canvas.addEventListener('mouseleave', () => {
      if (hoveredNode) {
        hoveredNode = null;
        draw();
      }
    });

    canvas.addEventListener('mousedown', (e) => {
      const { x, y } = getCanvasCoords(e);
      const hit = nodes.find((n) => Math.hypot(n.x - x, n.y - y) <= n.radius + 6);

      if (hit) {
        draggedNode = hit;
        hit.isDragging = true;
        selectedNode = hit;
        showPopover(hit);
        draw();
      }
    });

    window.addEventListener('mouseup', () => {
      if (draggedNode) {
        draggedNode.isDragging = false;
        draggedNode = null;
        draw();
      }
    });

    // 移动端 Touch
    canvas.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        const touch = e.touches[0];
        const rect = canvas.getBoundingClientRect();
        const x = touch.clientX - rect.left;
        const y = touch.clientY - rect.top;
        const hit = nodes.find((n) => Math.hypot(n.x - x, n.y - y) <= n.radius + 10);
        if (hit) {
          draggedNode = hit;
          hit.isDragging = true;
          selectedNode = hit;
          showPopover(hit);
          draw();
        }
      }
    }, { passive: true });

    canvas.addEventListener('touchmove', (e) => {
      if (draggedNode && e.touches.length === 1) {
        const touch = e.touches[0];
        const rect = canvas.getBoundingClientRect();
        draggedNode.x = touch.clientX - rect.left;
        draggedNode.y = touch.clientY - rect.top;
        draw();
      }
    }, { passive: true });

    canvas.addEventListener('touchend', () => {
      if (draggedNode) {
        draggedNode.isDragging = false;
        draggedNode = null;
        draw();
      }
    });

    function showPopover(node) {
      if (!popover || !popoverTitle || !popoverBadge || !popoverTags || !popoverLink) return;

      const c = colors[node.status] || colors['in-progress'];
      popoverTitle.textContent = node.title;
      popoverBadge.textContent = `${c.label} · ${Math.round(node.confidence * 100)}% 确信`;
      popoverBadge.className = `px-2 py-0.5 rounded-full text-[10px] font-mono font-medium border ${c.badge}`;

      popoverTags.innerHTML = '';
      node.tags.forEach((t) => {
        const span = document.createElement('span');
        span.className = 'text-[10px] font-mono bg-surface border border-border px-1.5 py-0.5 rounded text-muted';
        span.textContent = `#${t}`;
        popoverTags.appendChild(span);
      });

      popoverLink.href = `${baseUrl}/docs/${node.slug}`;

      popover.classList.remove('opacity-0', 'translate-y-8', 'pointer-events-none');
      popover.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
    }

    function hidePopover() {
      if (!popover) return;
      popover.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
      popover.classList.add('opacity-0', 'translate-y-8', 'pointer-events-none');
      selectedNode = null;
      draw();
    }

    if (popoverClose) {
      popoverClose.addEventListener('click', hidePopover);
    }

    canvas.addEventListener('dblclick', () => {
      if (hoveredNode) {
        window.location.href = `${baseUrl}/docs/${hoveredNode.slug}`;
      }
    });

    window.addEventListener('resize', () => {
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      draw();
    });

    // 页面加载完毕：直接静止渲染一帧就位！
    draw();
  })();
</script>
