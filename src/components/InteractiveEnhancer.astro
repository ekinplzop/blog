---
import snapshotsData from '../data/snapshots.json';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div id="interactive-enhancer-anchor" class="hidden"></div>

<script is:inline define:vars={{ snapshotsData, baseUrl }}>
  // ============================================================
  // 1. Obsidian Callout 原生提示框渲染引擎
  // ============================================================
  const CALLOUT_CONFIG = {
    danger: {
      icon: '🛑',
      title: '高频考点警示',
      classes: 'border-l-4 border-rose-500 bg-rose-500/10 text-content',
      titleColor: 'text-rose-500 dark:text-rose-400 font-bold',
    },
    error: {
      icon: '🛑',
      title: '注意避坑',
      classes: 'border-l-4 border-rose-500 bg-rose-500/10 text-content',
      titleColor: 'text-rose-500 dark:text-rose-400 font-bold',
    },
    tip: {
      icon: '💡',
      title: '考点解题规律',
      classes: 'border-l-4 border-emerald-500 bg-emerald-500/10 text-content',
      titleColor: 'text-emerald-600 dark:text-emerald-400 font-bold',
    },
    hint: {
      icon: '💡',
      title: '提示',
      classes: 'border-l-4 border-emerald-500 bg-emerald-500/10 text-content',
      titleColor: 'text-emerald-600 dark:text-emerald-400 font-bold',
    },
    note: {
      icon: '📝',
      title: '核心概念注解',
      classes: 'border-l-4 border-sky-500 bg-sky-500/10 text-content',
      titleColor: 'text-sky-600 dark:text-sky-400 font-bold',
    },
    info: {
      icon: 'ℹ️',
      title: '说明',
      classes: 'border-l-4 border-sky-500 bg-sky-500/10 text-content',
      titleColor: 'text-sky-600 dark:text-sky-400 font-bold',
    },
    warning: {
      icon: '⚡',
      title: '注意事项',
      classes: 'border-l-4 border-amber-500 bg-amber-500/10 text-content',
      titleColor: 'text-amber-600 dark:text-amber-400 font-bold',
    },
  };

  function enhanceCallouts() {
    const article = document.querySelector('article');
    if (!article) return;

    const blockquotes = article.querySelectorAll('blockquote');
    blockquotes.forEach((bq) => {
      const firstP = bq.querySelector('p');
      if (!firstP) return;

      const html = firstP.innerHTML.trim();
      const match = html.match(/^\[!([a-zA-Z_-]+)\]\s*(.*)/i);
      if (!match) return;

      const type = match[1].toLowerCase();
      const customTitle = match[2].trim();
      const cfg = CALLOUT_CONFIG[type] || CALLOUT_CONFIG['note'];

      firstP.innerHTML = customTitle ? customTitle : '';
      if (!firstP.innerHTML.trim()) {
        firstP.remove();
      }

      const card = document.createElement('div');
      card.className = `my-6 p-4 rounded-r-xl border border-border/60 ${cfg.classes} shadow-xs transition-all`;

      const header = document.createElement('div');
      header.className = `flex items-center gap-2 mb-2 font-mono text-xs ${cfg.titleColor}`;
      header.innerHTML = `<span>${cfg.icon}</span><span class="uppercase tracking-wider">${customTitle ? customTitle : cfg.title}</span>`;

      card.appendChild(header);
      while (bq.firstChild) {
        card.appendChild(bq.firstChild);
      }

      bq.parentNode?.replaceChild(card, bq);
    });
  }

  // ============================================================
  // 2. Reactive Markdown 通用语法引擎 (Scrubbable Numbers & Calc)
  // ============================================================
  const reactiveStore = {};

  function safeEvaluate(expr) {
    try {
      let sanitized = expr;
      for (const [v, val] of Object.entries(reactiveStore)) {
        const reg = new RegExp(`\\b${v}\\b`, 'g');
        sanitized = sanitized.replace(reg, String(val));
      }

      const stripped = sanitized
        .replace(/Math\.(floor|ceil|round|abs|sqrt|pow|log|log2|log10|min|max|PI|E)/g, '')
        .replace(/[0-9.]+/g, '');

      if (/[^+\-*/%(),\s]/.test(stripped)) {
        return NaN;
      }

      return Function(`"use strict"; return (${sanitized});`)();
    } catch {
      return NaN;
    }
  }

  function updateAllCalculations() {
    const calcs = document.querySelectorAll('.reactive-calc');
    calcs.forEach((el) => {
      const expr = el.getAttribute('data-expr');
      if (!expr) return;
      const res = safeEvaluate(expr);
      el.textContent = isNaN(res) ? 'Err' : (Number.isInteger(res) ? String(res) : res.toFixed(2));
    });
  }

  function enhanceReactiveDSL() {
    const article = document.querySelector('article');
    if (!article) return;

    const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT, null);
    const nodesToReplace = [];

    while (walker.nextNode()) {
      const node = walker.currentNode;
      if (node.nodeValue && (/\[bind:[^\]]+\]/.test(node.nodeValue) || /\[calc:[^\]]+\]/.test(node.nodeValue))) {
        if (!node.parentElement?.closest('pre, code')) {
          nodesToReplace.push({ node, parent: node.parentNode });
        }
      }
    }

    nodesToReplace.forEach(({ node, parent }) => {
      let text = node.nodeValue || '';
      const span = document.createElement('span');

      text = text.replace(/\[bind:\s*([a-zA-Z0-9_]+)([^\]]*)\]/g, (_, varName, rawParams) => {
        let min = 0, max = 100, def = 5, step = 1;
        rawParams.replace(/([a-zA-Z]+)=([0-9.-]+)/g, (_, k, v) => {
          if (k === 'min') min = parseFloat(v);
          if (k === 'max') max = parseFloat(v);
          if (k === 'default') def = parseFloat(v);
          if (k === 'step') step = parseFloat(v);
        });

        reactiveStore[varName] = def;

        return `<span class="reactive-bind inline-flex items-center gap-1 px-2 py-0.5 mx-1 rounded border-2 border-dashed border-sky-400/60 bg-sky-500/10 text-sky-400 font-mono text-xs font-bold cursor-ew-resize select-none hover:bg-sky-500/20 active:scale-95 transition-all" data-var="${varName}" data-min="${min}" data-max="${max}" data-step="${step}" data-val="${def}" title="按住鼠标左键左右拖拽调整数值"><span>${varName} =</span><span class="bind-val underline underline-offset-2">${def}</span><span class="text-[10px] opacity-60">⟷</span></span>`;
      });

      text = text.replace(/\[calc:\s*([^\]]+)\]/g, (_, expr) => {
        return `<span class="reactive-calc px-2 py-0.5 mx-1 rounded bg-surface border border-emerald-500/40 text-emerald-400 font-mono text-xs font-bold shadow-xs" data-expr="${expr.trim()}">0</span>`;
      });

      span.innerHTML = text;
      parent.replaceChild(span, node);
    });

    const binders = document.querySelectorAll('.reactive-bind');
    binders.forEach((binder) => {
      const varName = binder.getAttribute('data-var');
      const min = parseFloat(binder.getAttribute('data-min') || '0');
      const max = parseFloat(binder.getAttribute('data-max') || '100');
      const step = parseFloat(binder.getAttribute('data-step') || '1');
      const valDisplay = binder.querySelector('.bind-val');

      let isDragging = false;
      let startX = 0;
      let startVal = reactiveStore[varName] || min;

      binder.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.clientX;
        startVal = reactiveStore[varName];
        document.body.style.cursor = 'ew-resize';
        document.body.style.userSelect = 'none';
        e.preventDefault();
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        const delta = Math.round(dx / 12) * step;
        let next = startVal + delta;
        next = Math.max(min, Math.min(max, next));

        if (reactiveStore[varName] !== next) {
          reactiveStore[varName] = next;
          valDisplay.textContent = String(next);
          updateAllCalculations();
        }
      });

      window.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          document.body.style.cursor = '';
          document.body.style.userSelect = '';
        }
      });

      binder.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          isDragging = true;
          startX = e.touches[0].clientX;
          startVal = reactiveStore[varName];
        }
      }, { passive: true });

      window.addEventListener('touchmove', (e) => {
        if (!isDragging || e.touches.length !== 1) return;
        const dx = e.touches[0].clientX - startX;
        const delta = Math.round(dx / 14) * step;
        let next = startVal + delta;
        next = Math.max(min, Math.min(max, next));

        if (reactiveStore[varName] !== next) {
          reactiveStore[varName] = next;
          valDisplay.textContent = String(next);
          updateAllCalculations();
        }
      }, { passive: true });

      window.addEventListener('touchend', () => {
        isDragging = false;
      });
    });

    updateAllCalculations();
  }

  // ============================================================
  // 3. 外链永久快照 (Perma-Snapshot) 双轨防404跳转徽章
  // ============================================================
  function enhanceExternalLinksAndSnapshots() {
    const article = document.querySelector('article');
    if (!article) return;

    const links = article.querySelectorAll('a[href^="http://"], a[href^="https://"]');
    links.forEach((a) => {
      if (a.getAttribute('data-perma-processed') || a.closest('.perma-header')) return;
      a.setAttribute('data-perma-processed', 'true');

      const href = a.getAttribute('href') || '';
      if (href.includes('localhost') || href.includes('127.0.0.1') || href.includes('github.com/ekinplzop/blog')) return;

      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');

      const snapshot = snapshotsData && snapshotsData[href];
      if (snapshot && snapshot.status === 'saved') {
        const badge = document.createElement('a');
        badge.href = `${baseUrl}/snapshots/${snapshot.hash}.html`;
        badge.target = '_blank';
        badge.rel = 'noopener noreferrer';
        badge.className = 'snapshot-badge ml-1.5 px-1.5 py-0.5 rounded text-[10px] font-mono border border-emerald-500/40 text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20 transition-all inline-flex items-center gap-0.5 no-underline align-middle shadow-xs';
        badge.title = `查看于 ${snapshot.date} 捕获的永久离线快照 (永不404死链)`;
        badge.innerHTML = `<span>🏛️</span><span class="underline decoration-dotted">快照</span>`;
        a.after(badge);
      } else {
        if (!a.textContent?.includes('↗')) {
          const arrow = document.createElement('span');
          arrow.className = 'text-xs text-muted/60 ml-0.5 font-mono';
          arrow.textContent = '↗';
          a.appendChild(arrow);
        }
      }
    });
  }

  // DOM 启动器
  function initEnhancements() {
    enhanceCallouts();
    enhanceReactiveDSL();
    enhanceExternalLinksAndSnapshots();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEnhancements);
  } else {
    initEnhancements();
  }
</script>
