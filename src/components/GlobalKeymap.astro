---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- Vimium 级中英双语极客快捷键漫游面板 (按下 ? 唤出) -->
<div
  id="keymap-help-modal"
  class="fixed inset-0 z-50 bg-black/75 backdrop-blur-md flex items-center justify-center p-3 sm:p-4 opacity-0 pointer-events-none transition-opacity duration-200 select-none not-prose"
>
  <div
    id="keymap-modal-card"
    class="w-full max-w-2xl rounded-2xl bg-[#121216] text-zinc-100 border border-zinc-700/80 shadow-2xl p-5 sm:p-7 transform scale-95 transition-all duration-200 flex flex-col max-h-[90vh]"
  >
    <!-- 头部：Vimium 风格标题栏与中英双语切换器 -->
    <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-border/80">
      <div class="flex items-center gap-2 font-mono">
        <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-pulse"></span>
        <span class="text-sm sm:text-base font-bold text-content tracking-tight">
          Cognitive Kernel <span class="text-sky-400 font-normal">· Vimium Help</span>
        </span>
      </div>

      <div class="flex items-center gap-2">
        <!-- 语言切换三联胶囊 -->
        <div class="inline-flex p-0.5 rounded-lg bg-surface border border-border text-[11px] font-mono">
          <button
            id="lang-btn-bi"
            class="px-2 py-0.5 rounded-md text-sky-400 bg-sky-500/15 font-semibold transition-all cursor-pointer"
            title="中英双语对照 / Bilingual"
          >
            🌐 双语
          </button>
          <button
            id="lang-btn-zh"
            class="px-2 py-0.5 rounded-md text-muted hover:text-content transition-all cursor-pointer"
            title="仅中文"
          >
            中文
          </button>
          <button
            id="lang-btn-en"
            class="px-2 py-0.5 rounded-md text-muted hover:text-content transition-all cursor-pointer"
            title="English Only"
          >
            EN
          </button>
        </div>

        <button
          id="keymap-close-btn"
          class="text-muted hover:text-content text-sm px-2 py-1 rounded-md hover:bg-surface border border-transparent hover:border-border cursor-pointer font-mono font-bold transition-all"
          title="关闭 (Esc)"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- 快捷键双栏对照区 (仿照 Vimium 经典学术排版) -->
    <div id="keymap-content-body" class="flex-1 overflow-y-auto pr-1 grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono">
      
      <!-- 左栏：页面滚动与空间漫游 -->
      <div class="space-y-4">
        <!-- 分组 1：页面漫游 -->
        <div class="space-y-2">
          <div class="text-[11px] font-bold text-sky-400 uppercase tracking-wider border-b border-border/40 pb-1 flex items-center justify-between">
            <span class="lang-zh">页面平移与浏览</span>
            <span class="lang-en text-muted font-normal text-[10px]">Navigating the page</span>
          </div>

          <!-- j / k -->
          <div class="flex items-center justify-between py-1 hover:bg-surface/50 px-1.5 rounded-lg transition-colors">
            <div class="flex items-center gap-1.5 shrink-0">
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-sky-300 font-bold">j</kbd>
              <span class="text-muted">/</span>
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-sky-300 font-bold">k</kbd>
            </div>
            <div class="text-right">
              <span class="text-content lang-zh font-medium">向下 / 向上微步平移</span>
              <span class="text-muted/70 lang-en text-[10px] block">Scroll down / up</span>
            </div>
          </div>

          <!-- d / u -->
          <div class="flex items-center justify-between py-1 hover:bg-surface/50 px-1.5 rounded-lg transition-colors">
            <div class="flex items-center gap-1.5 shrink-0">
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-sky-300 font-bold">d</kbd>
              <span class="text-muted">/</span>
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-sky-300 font-bold">u</kbd>
            </div>
            <div class="text-right">
              <span class="text-content lang-zh font-medium">向下 / 向上半屏跳跃</span>
              <span class="text-muted/70 lang-en text-[10px] block">Scroll half page down / up</span>
            </div>
          </div>

          <!-- gg / G -->
          <div class="flex items-center justify-between py-1 hover:bg-surface/50 px-1.5 rounded-lg transition-colors">
            <div class="flex items-center gap-1.5 shrink-0">
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-sky-300 font-bold">g</kbd><kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-sky-300 font-bold">g</kbd>
              <span class="text-muted">/</span>
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-sky-300 font-bold">G</kbd>
            </div>
            <div class="text-right">
              <span class="text-content lang-zh font-medium">滚动到页面顶部 / 底部</span>
              <span class="text-muted/70 lang-en text-[10px] block">Scroll to top / bottom</span>
            </div>
          </div>

          <!-- z -->
          <div class="flex items-center justify-between py-1 hover:bg-surface/50 px-1.5 rounded-lg transition-colors">
            <div class="flex items-center gap-1.5 shrink-0">
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-emerald-400 font-bold">z</kbd>
            </div>
            <div class="text-right">
              <span class="text-content lang-zh font-medium">全屏专注阅读模式</span>
              <span class="text-muted/70 lang-en text-[10px] block">Toggle Zen focus mode</span>
            </div>
          </div>

          <!-- t -->
          <div class="flex items-center justify-between py-1 hover:bg-surface/50 px-1.5 rounded-lg transition-colors">
            <div class="flex items-center gap-1.5 shrink-0">
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-emerald-400 font-bold">t</kbd>
            </div>
            <div class="text-right">
              <span class="text-content lang-zh font-medium">思想演进时光机穿梭</span>
              <span class="text-muted/70 lang-en text-[10px] block">Cycle Time-Machine diff</span>
            </div>
          </div>
        </div>

        <!-- 分组 2：空间导航 -->
        <div class="space-y-2 pt-2">
          <div class="text-[11px] font-bold text-sky-400 uppercase tracking-wider border-b border-border/40 pb-1 flex items-center justify-between">
            <span class="lang-zh">空间导航与切换</span>
            <span class="lang-en text-muted font-normal text-[10px]">Spatial navigation</span>
          </div>

          <!-- g h -->
          <div class="flex items-center justify-between py-1 hover:bg-surface/50 px-1.5 rounded-lg transition-colors">
            <div class="flex items-center gap-1 shrink-0">
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-amber-300 font-bold">g</kbd>
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-amber-300 font-bold">h</kbd>
            </div>
            <div class="text-right">
              <span class="text-content lang-zh font-medium">回到博客首页</span>
              <span class="text-muted/70 lang-en text-[10px] block">Go to home</span>
            </div>
          </div>

          <!-- g s -->
          <div class="flex items-center justify-between py-1 hover:bg-surface/50 px-1.5 rounded-lg transition-colors">
            <div class="flex items-center gap-1 shrink-0">
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-amber-300 font-bold">g</kbd>
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-amber-300 font-bold">s</kbd>
            </div>
            <div class="text-right">
              <span class="text-content lang-zh font-medium">聚焦认知星图</span>
              <span class="text-muted/70 lang-en text-[10px] block">Focus Constellation Atlas</span>
            </div>
          </div>

          <!-- v -->
          <div class="flex items-center justify-between py-1 hover:bg-surface/50 px-1.5 rounded-lg transition-colors">
            <div class="flex items-center gap-1.5 shrink-0">
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-amber-300 font-bold">v</kbd>
            </div>
            <div class="text-right">
              <span class="text-content lang-zh font-medium">星图 ↔ 矩阵双模切换</span>
              <span class="text-muted/70 lang-en text-[10px] block">Toggle Atlas / Matrix view</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 右栏：Vomnibar 神经检索与系统指令 -->
      <div class="space-y-4">
        <!-- 分组 3：Vomnibar 神经命令搜索 -->
        <div class="space-y-2">
          <div class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider border-b border-border/40 pb-1 flex items-center justify-between">
            <span class="lang-zh">神经控制台 (Vomnibar)</span>
            <span class="lang-en text-muted font-normal text-[10px]">Using the Command Bar</span>
          </div>

          <!-- o / / -->
          <div class="flex items-center justify-between py-1 hover:bg-surface/50 px-1.5 rounded-lg transition-colors">
            <div class="flex items-center gap-1.5 shrink-0">
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-emerald-300 font-bold">o</kbd>
              <span class="text-muted">,</span>
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-emerald-300 font-bold">/</kbd>
            </div>
            <div class="text-right">
              <span class="text-content lang-zh font-medium">呼出全站神经命令搜索</span>
              <span class="text-muted/70 lang-en text-[10px] block">Open Command Palette (Vomnibar)</span>
            </div>
          </div>

          <!-- ⌘K -->
          <div class="flex items-center justify-between py-1 hover:bg-surface/50 px-1.5 rounded-lg transition-colors">
            <div class="flex items-center gap-1 shrink-0">
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-emerald-300 font-bold">⌘</kbd><kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-emerald-300 font-bold">K</kbd>
              <span class="text-muted">/</span>
              <kbd class="px-1 py-0.5 rounded bg-surface border border-border text-[10px]">Ctrl+K</kbd>
            </div>
            <div class="text-right">
              <span class="text-content lang-zh font-medium">快速过滤文章与标签</span>
              <span class="text-muted/70 lang-en text-[10px] block">Filter articles by title or tag</span>
            </div>
          </div>

          <!-- Esc -->
          <div class="flex items-center justify-between py-1 hover:bg-surface/50 px-1.5 rounded-lg transition-colors">
            <div class="flex items-center gap-1.5 shrink-0">
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-muted font-bold">Esc</kbd>
            </div>
            <div class="text-right">
              <span class="text-content lang-zh font-medium">关闭弹窗 / 清除焦点</span>
              <span class="text-muted/70 lang-en text-[10px] block">Close dialog / blur input</span>
            </div>
          </div>
        </div>

        <!-- 分组 4：系统杂项与外观 -->
        <div class="space-y-2 pt-2">
          <div class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider border-b border-border/40 pb-1 flex items-center justify-between">
            <span class="lang-zh">系统偏好与帮助</span>
            <span class="lang-en text-muted font-normal text-[10px]">Preferences & Help</span>
          </div>

          <!-- ? -->
          <div class="flex items-center justify-between py-1 hover:bg-surface/50 px-1.5 rounded-lg transition-colors">
            <div class="flex items-center gap-1.5 shrink-0">
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-rose-400 font-bold">?</kbd>
            </div>
            <div class="text-right">
              <span class="text-content lang-zh font-medium">打开 / 关闭此快捷键面板</span>
              <span class="text-muted/70 lang-en text-[10px] block">Show / hide this help modal</span>
            </div>
          </div>

          <!-- Shift + D -->
          <div class="flex items-center justify-between py-1 hover:bg-surface/50 px-1.5 rounded-lg transition-colors">
            <div class="flex items-center gap-1 shrink-0">
              <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-rose-400 font-bold">Shift</kbd><kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-rose-400 font-bold">D</kbd>
            </div>
            <div class="text-right">
              <span class="text-content lang-zh font-medium">切换暗黑 / 浅色模式</span>
              <span class="text-muted/70 lang-en text-[10px] block">Toggle Dark / Light theme</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- 底部：Vimium 风格说明与版本号 -->
    <div class="mt-4 pt-3 border-t border-border/80 text-[11px] font-mono text-muted flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="text-emerald-400">●</span>
        <span class="lang-zh">纯原生状态机驱动 · 输入框内自动静默防误触</span>
        <span class="lang-en hidden text-[10px]">Native keyboard state machine · Safe inside text inputs</span>
      </div>
      <div class="text-[10px] text-muted/60">
        Vimium Standard · Cognitive Kernel v4.5
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ baseUrl }}>
  (function () {
    const modal = document.getElementById('keymap-help-modal');
    const closeBtn = document.getElementById('keymap-close-btn');
    const container = document.getElementById('keymap-content-body');
    const langBtnBi = document.getElementById('lang-btn-bi');
    const langBtnZh = document.getElementById('lang-btn-zh');
    const langBtnEn = document.getElementById('lang-btn-en');

    if (!modal) return;

    let isHelpOpen = false;
    let lastKey = '';
    let keyTimeout = null;

    // 1. 中英双语切换引擎 (Bilingual / Chinese / English)
    let currentLang = localStorage.getItem('garden-keymap-lang') || 'bi';

    function setLanguage(mode) {
      currentLang = mode;
      localStorage.setItem('garden-keymap-lang', mode);

      const defaultBtn = 'px-2 py-0.5 rounded-md text-muted hover:text-content transition-all cursor-pointer';
      const activeBtn = 'px-2 py-0.5 rounded-md text-sky-400 bg-sky-500/15 font-semibold transition-all cursor-pointer';

      if (langBtnBi) langBtnBi.className = mode === 'bi' ? activeBtn : defaultBtn;
      if (langBtnZh) langBtnZh.className = mode === 'zh' ? activeBtn : defaultBtn;
      if (langBtnEn) langBtnEn.className = mode === 'en' ? activeBtn : defaultBtn;

      const zhElements = modal.querySelectorAll('.lang-zh');
      const enElements = modal.querySelectorAll('.lang-en');

      if (mode === 'zh') {
        zhElements.forEach(el => el.classList.remove('hidden'));
        enElements.forEach(el => el.classList.add('hidden'));
      } else if (mode === 'en') {
        zhElements.forEach(el => el.classList.add('hidden'));
        enElements.forEach(el => el.classList.remove('hidden'));
      } else {
        // 双语对照 (Bilingual)
        zhElements.forEach(el => el.classList.remove('hidden'));
        enElements.forEach(el => el.classList.remove('hidden'));
      }
    }

    if (langBtnBi) langBtnBi.addEventListener('click', () => setLanguage('bi'));
    if (langBtnZh) langBtnZh.addEventListener('click', () => setLanguage('zh'));
    if (langBtnEn) langBtnEn.addEventListener('click', () => setLanguage('en'));

    // 初始化应用语言
    setLanguage(currentLang);

    // 2. 呼出与关闭
    function openHelp() {
      isHelpOpen = true;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      const card = document.getElementById('keymap-modal-card');
      if (card) {
        card.classList.remove('scale-95');
        card.classList.add('scale-100');
      }
    }

    function closeHelp() {
      isHelpOpen = false;
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      const card = document.getElementById('keymap-modal-card');
      if (card) {
        card.classList.remove('scale-100');
        card.classList.add('scale-95');
      }
    }

    if (closeBtn) closeBtn.addEventListener('click', closeHelp);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeHelp();
    });

    // 暴露全局切换函数，由按钮 onclick 单一控制，避免双重事件监听竞争
    window.openKeymapHelp = function () {
      if (isHelpOpen) closeHelp();
      else openHelp();
    };

    // 3. 全局 Vimium 快捷键状态机监听
    window.addEventListener('keydown', (e) => {
      // 若聚焦在输入框内，自动静默防误触
      const targetTag = (e.target.tagName || '').toLowerCase();
      if (targetTag === 'input' || targetTag === 'textarea' || e.target.isContentEditable) {
        return;
      }

      // ESC 退出
      if (e.key === 'Escape') {
        if (isHelpOpen) {
          e.preventDefault();
          closeHelp();
          return;
        }
      }

      // ? 呼出帮助 (支持 ? 键或 Shift + / 或 Shift + Slash)
      if (e.key === '?' || (e.shiftKey && (e.key === '/' || e.code === 'Slash'))) {
        e.preventDefault();
        if (isHelpOpen) closeHelp();
        else openHelp();
        return;
      }

      // / 或 o 呼出 Vomnibar (搜索控制台)
      if ((e.key === '/' || e.key.toLowerCase() === 'o') && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        if (window.openCommandPalette) {
          window.openCommandPalette();
        }
        return;
      }

      // z 一键切换专注模式
      if (e.key.toLowerCase() === 'z' && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        if (window.toggleZenMode) {
          window.toggleZenMode();
        }
        return;
      }

      // t 一键切换时光机演进 Diff
      if (e.key.toLowerCase() === 't' && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        const slider = document.getElementById('tm-date-slider');
        if (slider) {
          let nextVal = (parseInt(slider.value, 10) + 1) % 3;
          slider.value = String(nextVal);
          slider.dispatchEvent(new Event('input'));
        }
        return;
      }

      // v 一键在星图/矩阵间切换
      if (e.key.toLowerCase() === 'v' && !e.metaKey && !e.ctrlKey) {
        const atlasBtn = document.getElementById('mode-atlas-btn');
        const matrixBtn = document.getElementById('mode-matrix-btn');
        if (atlasBtn && matrixBtn) {
          e.preventDefault();
          const currentMode = localStorage.getItem('garden-view-mode') || 'atlas';
          if (currentMode === 'atlas') matrixBtn.click();
          else atlasBtn.click();
        }
        return;
      }

      // Shift + D 切换主题
      if (e.shiftKey && e.key.toLowerCase() === 'd') {
        e.preventDefault();
        const toggle = document.getElementById('theme-toggle');
        if (toggle) toggle.click();
        return;
      }

      // j / k 微步平移 (Vimium 标配)
      if (e.key === 'j' && !e.metaKey && !e.ctrlKey) {
        window.scrollBy({ top: 90, behavior: 'smooth' });
        return;
      }
      if (e.key === 'k' && !e.metaKey && !e.ctrlKey) {
        window.scrollBy({ top: -90, behavior: 'smooth' });
        return;
      }

      // d / u 半屏翻页 (Vimium 标配)
      if (e.key === 'd' && !e.metaKey && !e.ctrlKey) {
        window.scrollBy({ top: window.innerHeight * 0.5, behavior: 'smooth' });
        return;
      }
      if (e.key === 'u' && !e.metaKey && !e.ctrlKey) {
        window.scrollBy({ top: -window.innerHeight * 0.5, behavior: 'smooth' });
        return;
      }

      // G 滚动到底部 (Shift + g)
      if (e.shiftKey && e.key === 'G') {
        e.preventDefault();
        window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
        return;
      }

      // g 序列状态机: gg 顶部, gh 首页, gs 星图
      if (e.key.toLowerCase() === 'g' && !e.shiftKey) {
        if (lastKey === 'g') {
          // gg -> 滚动到顶部
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
          lastKey = '';
          return;
        } else {
          lastKey = 'g';
          clearTimeout(keyTimeout);
          keyTimeout = setTimeout(() => { lastKey = ''; }, 600);
          return;
        }
      }

      if (lastKey === 'g') {
        if (e.key.toLowerCase() === 'h') {
          e.preventDefault();
          window.location.href = `${baseUrl}/`;
        } else if (e.key.toLowerCase() === 's') {
          e.preventDefault();
          const canvas = document.getElementById('cognitive-canvas');
          if (canvas) {
            canvas.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            window.location.href = `${baseUrl}/#view-atlas`;
          }
        }
        lastKey = '';
      }
    });
  })();
</script>
